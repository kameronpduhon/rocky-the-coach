{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "rocky",
	"compatibility_date": "2026-10-01",
	"main": "./workers/app.ts",
	"routes": [{ "pattern": "kampduh.com", "custom_domain": true }],
	// D1's primary runs in Atlanta, and Today makes several queries per tap. Running the Worker beside it turns each
	// query into a local hop instead of a trip from whichever colo the phone hit. Smart placement would need more
	// traffic than one user sends, so the region is pinned (GCP us-east1, South Carolina, is the nearest to ATL).
	"placement": { "region": "gcp:us-east1" },
	"d1_databases": [
		{ "binding": "DB", "database_name": "rocky-db", "database_id": "0b2f0bdb-8153-484e-9acc-3cd60c2613e0", "migrations_dir": "drizzle" }
	],
	"r2_buckets": [{ "binding": "MEDIA", "bucket_name": "rocky-media" }],
	// Dev-only clock pin, overridden from .dev.vars. Empty here, and production builds never read it.
	"vars": { "DEV_NOW": "" },
	"secrets": {
		"required": ["APP_PASSWORD", "SESSION_SECRET", "INGEST_TOKEN", "VAPID_PUBLIC_KEY", "VAPID_PRIVATE_KEY"]
	},
	"triggers": { "crons": ["*/5 * * * *", "0 9 * * SUN"] },
	"observability": { "enabled": true },
	"upload_source_maps": true
}
