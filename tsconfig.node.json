{
  "extends": "./tsconfig.json",
  "include": [
    "vite.config.ts",
    "vitest.config.ts",
    "drizzle.config.ts",
    "drizzle.core.config.ts",
    "scripts/**/*.ts",
    "app/domain/**/*.ts",
    "app/server/password.ts",
    "app/sync/tables.ts",
    "app/content/schema.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "types": [
      "node"
    ],
    "lib": [
      "ES2022"
    ],
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler"
  }
}
